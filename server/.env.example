# Postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/agent
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/agent

# Ollama Cloud (LLM) - https://ollama.com
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
LLM_TEMPERATURE=0.7

# Hugging Face Inference API (embeddings) - https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Memory
SHORT_TERM_WINDOW=12
LONG_TERM_TOP_K=5
MEMORY_IMPORTANCE_THRESHOLD=0.5

# Proactive messaging
PROACTIVE_INACTIVITY_MINUTES=720
PROACTIVE_CHECK_INTERVAL_SECONDS=300

# CORS - comma-separated list of allowed origins in production, e.g.
# https://your-app.netlify.app. Defaults to "*" (no auth in this app).
ALLOWED_ORIGINS=*
